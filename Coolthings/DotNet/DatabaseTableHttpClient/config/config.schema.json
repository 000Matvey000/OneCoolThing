{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatabaseTableHttpClient Integration Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["integrationName", "database", "mapping", "grainChecker", "http", "tracking"],
  "properties": {
    "integrationName": { "type": "string", "minLength": 1 },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "connectionString"],
      "properties": {
        "provider": { "type": "string", "enum": ["sqlserver", "postgresql"] },
        "connectionString": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "sourceQuery": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["table"] },
        { "required": ["sourceQuery"] }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headerFields", "detailFields"],
      "properties": {
        "headerFields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fieldMapping" }
        },
        "detailFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldMapping" }
        }
      }
    },
    "grainChecker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headerKeys"],
      "properties": {
        "headerKeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "table": { "type": "string", "minLength": 1 }
      }
    },
    "directories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logDirectory": { "type": "string", "minLength": 1 },
        "historyDirectory": { "type": "string", "minLength": 1 },
        "errorDirectory": { "type": "string", "minLength": 1 },
        "sentDirectory": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
